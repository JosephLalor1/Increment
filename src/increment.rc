// Windows resources: the .exe icon (shown in Explorer and on shortcuts) and version info.
// Compiled by build.bat with windres. Regenerate the icon with: build.bat icons
#include <winver.h>

1 ICON "assets/icon/increment.ico"

1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Increment - learn C and C++"
            VALUE "ProductName", "Increment"
            VALUE "FileVersion", "0.1.0"
            VALUE "ProductVersion", "0.1.0"
            VALUE "InternalName", "increment"
            VALUE "OriginalFilename", "increment.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
